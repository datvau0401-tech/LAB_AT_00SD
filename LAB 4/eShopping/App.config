<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <connectionStrings>
	  <add name="eShoppingDb"
	   connectionString="Data Source=TANDAT;Initial Catalog=eShoppingDB;User Id=sa;Password=123;TrustServerCertificate=True;MultipleActiveResultSets=True"
	   providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
