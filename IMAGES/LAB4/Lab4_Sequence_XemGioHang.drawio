        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class KHACHHANG {\n        +int MAKH\n        +string HOTEN\n        +date NGAYSINH\n        +string SOCMND\n        +string DIACHI\n        +string DIENTHOAI\n        +string TENDN\n        +string MATKHAU\n        +dangKyTaiKhoan() void\n        +dangNhap() boolean\n    }\n    class DONDATHANG {\n        +int MADONHANG\n        +date NGAYDAT\n        +string LOAIGIAOHANG\n        +double CHIPHIGIAOHANG\n        +double TONGTRIGIA\n        +string TRANGTHAI\n        +tinhTongTriGia() double\n        +ghiNhanDonHang() void\n    }\n    class CHITIETDONHANG {\n        +int SOLUONG\n        +double DONGIA\n        +tinhThanhTien() double\n    }\n    class THONGTINNGUOINHAN {\n        +string HOTEN\n        +string DIACHI\n        +string SDT\n        +capNhatThongTin() void\n    }\n    class GIOHANG {\n        +int MAGIOHANG\n        +double TONGTIEN\n        +layThongTinGioHang() GioHang\n        +tinhTongTien() double\n    }\n    class NHOMSP {\n        +int MANHOM\n        +string TENNHOM\n        +layDanhSachSanPham() List~SanPham~\n    }\n    class SANPHAM {\n        +int MASP\n        +string TENSP\n        +string NHASX\n        +string HINHANH\n        +string MOTA\n        +string THONGSOKYTHUAT\n        +double GAIBAN\n        +string TINHTRANG\n        +layThongTinSanPham() SanPham\n    }\n    class CHITIETGIOHANG {\n        +int SOLUONG\n        +double DONGIA\n        +capNhatSoLuong() void\n    }\n    class THETINDUNG {\n        +string LOAITHE\n        +string SOTHE\n        +date NGAYHETHAN\n        +string HOTENCHUTHE\n        +string MACSV\n        +double LEPHITHANHTOAN\n        +kiemTraThongTin() boolean\n    }\n    KHACHHANG \&quot;1\&quot; --&gt; \&quot;*\&quot; DONDATHANG\n    KHACHHANG \&quot;1\&quot; -- \&quot;1\&quot; GIOHANG\n    DONDATHANG \&quot;1\&quot; --&gt; \&quot;*\&quot; CHITIETDONHANG\n    DONDATHANG \&quot;1\&quot; -- \&quot;1\&quot; THONGTIN