class TheGiuXe {
    - maThe: int <<PK>>
    - maNhanVien: int <<FK>>
    - maPhuongTien: int <<FK>>
    - ngayCap: Date
    - trangThai: String
}

class PhuongTien {
    - maPhuongTien: int <<PK>>
    - bienSoXe: String
    - loaiXe: String
    - mauXe: String
}

NhanVienCongTy "1" -- "0..*" TheGiuXe : duoc cap
PhuongTien "1" -- "0..*" TheGiuXe : dang ky


class KiemTraPhong {
    - maKiemTra: int <<PK>>
    - maPhong: int <<FK>>
    - ngayKiemTra: Date
    - noiDung: String
    - ketQua: String
}

class BienBanViPham {
    - maBienBan: int <<PK>>
    - maPhong: int <<FK>>
    - maKiemTra: int <<FK>>
    - ngayLap: Date
    - noiDungViPham: String
