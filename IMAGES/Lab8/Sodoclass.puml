    - trangThai: String
}

Phong "1" -- "0..*" KiemTraPhong : duoc kiem tra
KiemTraPhong "1" -- "0..*" BienBanViPham : ghi nhan
Phong "1" -- "0..*" BienBanViPham : co vi pham

@enduml
