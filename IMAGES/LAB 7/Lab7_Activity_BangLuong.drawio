        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class TuyenDung {\n        -int maTuyenDung\n        -String viTri\n        -int soLuong\n        -Date ngayDang\n        -Date hanNop\n        -String moTa\n        -String trangThai\n        +taoTinTuyenDung() void\n        +capNhatTinTuyenDung() void\n        +dongTinTuyenDung() void\n    }\n    class HoSoUngVien {\n        -int maUngVien\n        -String hoTen\n        -Date ngaySinh\n        -String soDienThoai\n        -String email\n        -String diaChi\n        -String trinhDo\n        -String ketQuaPhongVan\n        -String trangThai\n        +tiepNhanHoSo() void\n        +capNhatHoSo() void\n        +danhGiaUngVien() void\n        +ghiNhanKetQua() void\n    }\n    class HopDongLaoDong {\n        -int maHopDong\n        -String loaiHopDong\n        -Date ngayKy\n        -Date ngayBatDau\n        -Date ngayHetHan\n        -double mucLuong\n        -String trangThai\n        +lapHopDong() void\n        +capNhatHopDong() void\n        +giaHanHopDong() void\n        +ketThucHopDong() void\n    }\n    class HoSoBaoHiem {\n        -int maHoSo\n        -String loaiBaoHiem\n        -String maSoBaoHiem\n        -Date ngayBatDau\n        -Date ngayKetThuc\n        -String trangThai\n        +themHoSo() void\n        +capNhatHoSo() void\n        +traCuuHoSo() void\n    }\n    class QuyetDinhLuong {\n        -int maQuyetDinhLuong\n        -double mucLuongCu\n        -double mucLuongMoi\n        -Date ngayQuyetDinh\n        -Date ngayApDung\n        -String lyDo\n        +lapQuyetDinh() void\n        +capNhatQuyetDinh() void\n        +pheDuyetQuyetDinh() void\n    }\n    class QuyetDinhChucVu {\n        -int maQuyetDinhChucVu\n        -String chucVuCu\n        -String chucVuMoi\n        -Date ngayQuyetDinh\n        -Date ngayApDung\n        -String lyDo\n        +lapQuyetDinh() void\n        +capNhatQuyetDinh() void\n        +pheDuyetQuyetDinh() void\n    }\n    class NhanVien {\n        -String maNV\n        -String hoTen\n        -Date ngaySinh\n        -String gioiTinh\n        -String diaChi\n        -String soDienThoai\n        -String email\n        -Date ngayVaoLam\n        -String trangThai\n        +themNhanVien() void\n        +capNhatThongTin() void\n        +xemLichLamViec() void\n        +xemPhieuLuong() void\n    }\n    class KhenThuongKyLuat {\n        -int maQuyetDinh\n        -String loaiQuyetDinh\n        -String noiDung\n        -double soTien\n        -Date ngayQuyetDinh\n        -String lyDo\n        +lapQuyetDinh() void\n        +capNhatQuyetDinh() void\n        +pheDuyetQuyetDinh() void\n    }\n    class LichLamViec {\n        -int maLich\n        -Date ngayLam\n        -String caLam\n        -Time gioBatDau\n        -Time gioKetThuc\n        -String loaiCa\n        +lapLich() void\n        +capNhatLich() void\n        +phanCaNhanVien() void\n    }\n    class ChamCong {\n        -int maChamCong\n        -Date ngayChamCong\n        -Time gioVao\n        -Time gioRa\n        -double soGioLam\n        -double soGioTangCa\n        -String trangThai\n        +ghiNhanChamCong() void\n        +capNhatChamCong() void\n        +tinhGioLam() double\n        +tinhGioTangCa() double\n    }\n    class BangLuong {\n        -int maBangLuong\n        -int thang\n        -int nam\n        -double luongCoBan\n        -double tienPhuCap\n        -double tienTangCa\n        -double tienKhauTru\n        -double tongLuong\n        -Date ngayLap\n        -String trangThai\n        +tinhLuong() double\n        +lapBangLuong() void\n        +xacNhanBangLuong() void\n    }\n    class PhieuThuChi {\n        -int maPhieu\n        -String loaiPhieu\n        -String noiDung\n        -double soTien\n        -Date ngayLap\n        -String nguoiLap\n        +lapPhieu() void\n        +capNhatPhieu() void\n        +inPhieu() void\n    }\n    TuyenDung \&quot;1\&quot; -- \&quot;0..*\&quot; HoSoUngVien\n    HoSoUngVien \&quot;0..1\&quot; -- \&quot;0..1\&quot; HopDongLaoDong : tuyển dụng\n    NhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; HopDongLaoDong\n    NhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; HoSoBaoHiem\n    NhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhLuong\n    NhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhChucVu\n    NhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; KhenThuongKyLuat\n    NhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; LichLamViec\n    NhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; ChamCong\n    LichLamViec \&quot;1\&quot; -- \&quot;0..*\&quot; ChamCong\n    NhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; BangLuong\n    BangLuong \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuThuChi\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="jT1UFDCSw57YSh4rMHjP-78">
