        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    title SEQUENCE DIAGRAM - NGHIỆP VỤ LẬP TOA THUỐC\n    actor BS as Bác sĩ\n    participant GD as Giao diện lập toa thuốc\n    participant XL as Xử lý toa thuốc\n    participant DB as Cơ sở dữ liệu\n    BS-&gt;&gt;GD: Chọn phiếu khám\n    GD-&gt;&gt;XL: Yêu cầu thông tin khám\n    XL-&gt;&gt;DB: Truy vấn phiếu khám\n    DB--&gt;&gt;XL: Thông tin phiếu khám\n    XL-&gt;&gt;DB: Truy vấn kết quả xét nghiệm\n    DB--&gt;&gt;XL: Kết quả xét nghiệm (nếu có)\n    XL--&gt;&gt;GD: Hiển thị thông tin khám\n    GD--&gt;&gt;BS: Hiển thị phiếu khám và kết quả\n    BS-&gt;&gt;GD: Nhập thông tin toa thuốc\n    GD-&gt;&gt;XL: Gửi thông tin toa thuốc\n    XL-&gt;&gt;XL: Kiểm tra dữ liệu toa thuốc\n    alt Thông tin không hợp lệ\n        XL--&gt;&gt;GD: Thông báo lỗi\n        GD--&gt;&gt;BS: Yêu cầu chỉnh sửa\n    else Thông tin hợp lệ\n        XL-&gt;&gt;DB: Bắt đầu giao dịch\n        XL-&gt;&gt;DB: Lưu thông tin toa thuốc\n        DB--&gt;&gt;XL: Trả về mã toa thuốc\n        XL-&gt;&gt;DB: Lưu chi tiết toa thuốc\n        DB--&gt;&gt;XL: Kết quả lưu chi tiết\n        alt Lưu thành công\n            XL-&gt;&gt;DB: Commit giao dịch\n            DB--&gt;&gt;XL: Xác nhận hoàn tất\n            XL--&gt;&gt;GD: Trả về toa thuốc đã lưu\n            GD--&gt;&gt;BS: Hiển thị toa thuốc thành công\n        else Lỗi khi lưu\n            XL-&gt;&gt;DB: Rollback giao dịch\n            DB--&gt;&gt;XL: Xác nhận hoàn tác\n            XL--&gt;&gt;GD: Thông báo lưu thất bại\n            GD--&gt;&gt;BS: Hiển thị thông báo lỗi\n        end\n    end\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="pYyaiYOfmT_65ALPZpHy-139">
